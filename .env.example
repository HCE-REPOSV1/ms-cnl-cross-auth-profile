# ms-cnl-cross-auth-profile — Auth Service
# Generated by Jarvis Platform

PORT=10701
NODE_ENV=development

# HTTPS (certificado autofirmado de prueba en ./certs-dev, montado en CERT_PATH via docker-compose.dev.yml)
USE_SSL=true
SSL_PORT=20701
CERT_PATH=/app/certs
# Ruta en el HOST del certificado, montada en CERT_PATH por docker-compose.dev.yml
CERTS_HOST_PATH=../certs-dev

# COOKIE_SECURE=true solo cuando el frontend accede al AG via HTTPS (puerto SSL)
# Con HTTP en el AG, debe ser false — la flag Secure impide que el browser envíe la cookie por HTTP
COOKIE_SECURE=true

# Servicio externo de autenticación (MAC, LDAP, OAuth, etc.)
# MAC .NET real (remoto, correcto pero sin conectividad desde esta PC) — referencia para revertir:
#EXTERNAL_AUTH_BASE_URL=https://desarrollo2.sanfelipe.com:8081/api/Seguridad
# MAC V2 local (Docker) via LegacyAuthController de ms-cnl-mac-auth, expuesto por apigw-cnl-mac-auth (puerto host 10640)
EXTERNAL_AUTH_BASE_URL=http://host.docker.internal:10640
EXTERNAL_AUTH_SISTEMA=HCE
# SSL_VERIFY=false → acepta certificados autofirmados o de CA interna
SSL_VERIFY=false
# CP0016 — Timeout MAC en ms (default 5000). Ajustar si la red hacia MAC es lenta
EXTERNAL_AUTH_TIMEOUT_MS=5000
# true (default) → cifra contrasena/actualContrasena/nuevaContrasena con AES-256-CBC
#                  antes de mandarlas al MAC (comportamiento de siempre, MAC .NET real).
# false          → las manda en texto plano (protegidas solo por TLS). Usar SOLO si
#                  EXTERNAL_AUTH_BASE_URL apunta a MAC V2 (NestJS), que hashea con
#                  bcrypt del lado servidor y no tiene sentido que reciba AES para
#                  desencriptar y recién ahí hashear. NO tocar CRYPTO_KEY/CRYPTO_IV
#                  en ese caso (no se usan).
# MAC V2 hashea passwords server-side con bcrypt (no AES) — desactivar el cifrado AES del lado cliente.
EXTERNAL_AUTH_ENCRYPT_PASSWORD=false
# AES-256-CBC — equivalente a Criptography.Encrypt() del sistema HCE (.NET)
# CRYPTO_KEY: exactamente 32 caracteres UTF-8
# CRYPTO_IV:  exactamente 16 caracteres UTF-8
# Exactamente 32 caracteres UTF-8 y 16 caracteres UTF-8 respectivamente. No reutilizar entre entornos.
CRYPTO_KEY=
CRYPTO_IV=

# ── JWT ───────────────────────────────────────────────────
# Debe coincidir EXACTAMENTE con JWT_SECRET de apigw-cnl-cross, apigw-cnl-web-emergency y apigw-tch
# (validan el token localmente sin llamar a este servicio).
JWT_SECRET=
JWT_EXPIRES_IN=4h
# Secret del refresh_token — DEBE ser distinto de JWT_SECRET (así un access_token
# filtrado no sirve para pedir un refresh, y viceversa)
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis (sesión única por usuario — HU01, + cache server-side del mac_token) ──
# MacTokenCacheService. En dev, redis:7-alpine sin password (ver docker-compose.dev.yml,
# mismo criterio que Kafka sin SASL en este proyecto). En producción, REDIS_PASSWORD es
# obligatorio y se carga desde Vault (VAULT_SECRET_PATH) — el mac_token es un credential
# vivo contra AD, no dejar el default vacío en ese entorno.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Kafka Audit Logger ────────────────────────────────────
# AUDIT_LOGGER_ENABLED=false desactiva el audit logger por completo:
# no se intenta conectar a Kafka y el logging se vuelve un no-op silencioso.
# Default: true (si no se define, el audit logger queda habilitado).
AUDIT_LOGGER_ENABLED=false
# Broker(s) Kafka separados por coma
KAFKA_BROKER=host.docker.internal:10403
# Topic al que este servicio publica eventos de auditoría
KAFKA_TOPIC=platform.logs
